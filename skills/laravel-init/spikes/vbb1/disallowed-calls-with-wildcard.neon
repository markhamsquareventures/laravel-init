parameters:
    filesRootDir: %rootDir%/../../..
    disallowedMethodCalls:
        -
            method: 'App\Models\*::update()'
            message: 'WILDCARD override probe'
            allowIn:
                - app/Models/*
                - database/*
                - tests/*
        -
            method: 'Illuminate\Database\Eloquent\Model::update()'
            message: 'use an action, not a direct write'
            allowIn: 
                - app/Models/*
