includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - vendor/shipmonk/dead-code-detector/rules.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/
        - tests/

    level: 8

    ignoreErrors:
        -
            identifier: shipmonk.deadMethod
            path: app/Actions/Fortify/ResetUserPassword.php
            message: '#::reset$#'
