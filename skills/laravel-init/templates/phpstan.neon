# phpstan/extension-installer is not installed, so each extension needs an include line.
includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - vendor/pestphp/pest-plugin-phpstan/extension.neon
    - vendor/shipmonk/dead-code-detector/rules.neon
    - vendor/spaze/phpstan-disallowed-calls/extension.neon
    - disallowed-calls.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/
        - tests/

    level: 8

    # Read model casts() methods. Without this, cast attributes have their raw column types.
    parseModelCastsMethod: true

    ignoreErrors:
        # Fortify calls reset() through the container, which returns mixed.
        -
            identifier: shipmonk.deadMethod
            path: app/Actions/Fortify/ResetUserPassword.php
            message: '#::reset$#'
