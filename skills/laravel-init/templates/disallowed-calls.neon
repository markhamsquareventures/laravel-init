# Enforces: writes to existing records happen only inside app/Models.
# Source of truth: the laravel-init skill, templates/disallowed-calls.neon
# The App\Models\* entries catch a model that overrides a write method, because
# disallowed-calls matches on the class that declares the method.
# Use single backslashes in single-quoted NEON strings.
parameters:
    filesRootDir: %rootDir%/../../..
    disallowedMethodCalls:
        -
            method: 'Illuminate\Database\Eloquent\Model::update()'
            message: 'writes to an existing record live on the model. Add a named method to the model (for example $meeting->cancel()) and call that'
            allowIn:
                - app/Models/*
                - database/*
                - tests/*
        -
            method: 'Illuminate\Database\Eloquent\Model::updateQuietly()'
            message: 'writes to an existing record live on the model. Add a named method to the model (for example $meeting->cancel()) and call that'
            allowIn:
                - app/Models/*
                - database/*
                - tests/*
